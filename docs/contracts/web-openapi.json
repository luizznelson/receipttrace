    "/api/uploads": {
      "post": {
        "summary": "Read a temporary receipt image with Gemini (opt-in) or local OCR",
        "description": "engine=ocr (default) never leaves the server. engine=gemini sends a sanitized JPEG to the Google Gemini free tier and requires the header `x-provider-consent: google-gemini-free`. Any Gemini problem falls back to local OCR and the response carries `fallback.reason`.",
        "operationId": "upload_api_uploads_post",
        "parameters": [
          {
            "name": "policy",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "brl-grouped",
                "usd-grouped",
                "idr-grouped"
              ],
              "type": "string",
              "default": "brl-grouped",
              "title": "Policy"
            }
          },
          {
            "name": "engine",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "ocr",
                "gemini"
              ],
              "type": "string",
              "default": "ocr",
              "title": "Engine"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Consent missing for Gemini, or unknown engine"
          },
          "413": {
            "description": "Image exceeds the byte limit"
          },
          "429": {
            "description": "OCR capacity or shared rate limit reached"
          },
          "503": {
            "description": "OCR unavailable or failed"
          },
          "504": {
            "description": "OCR worker exceeded its time limit"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
