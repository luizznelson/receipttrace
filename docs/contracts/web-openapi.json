              "$ref": "#/components/schemas/UploadedItem"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Items"
          },
          "policy": {
            "type": "string",
            "enum": [
              "brl-grouped",
              "usd-grouped",
              "idr-grouped"
            ],
            "title": "Policy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
