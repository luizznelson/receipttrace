            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JsonValue": {},
      "StartRequest": {
        "properties": {
          "example_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Example Id"
          },
          "method": {
