            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Correction"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Changes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actor",
          "reason",
          "changes"
        ],
        "title": "CorrectionRequest"
      },
      "CorrectionSubmission": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "correction": {
            "$ref": "#/components/schemas/CorrectionRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "correction"
        ],
        "title": "CorrectionSubmission"
      },
      "HTTPValidationError": {
