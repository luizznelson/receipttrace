            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          },
          "acknowledge_findings": {
            "type": "boolean",
            "title": "Acknowledge Findings",
            "default": false
          },
          "acknowledge_unverified": {
            "type": "boolean",
            "title": "Acknowledge Unverified",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
