  "components": {
    "schemas": {
      "CompletionRequest": {
        "properties": {
          "actor": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          },
          "acknowledge_findings": {
            "type": "boolean",
            "title": "Acknowledge Findings",
            "default": false
          },
          "acknowledge_unverified": {
            "type": "boolean",
            "title": "Acknowledge Unverified",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actor",
          "reason"
        ],
        "title": "CompletionRequest"
      },
      "CompletionSubmission": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "completion": {
            "$ref": "#/components/schemas/CompletionRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "completion"
        ],
        "title": "CompletionSubmission"
      },
      "Correction": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Path"
          },
          "value": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "value"
        ],
        "title": "Correction"
      },
      "CorrectionRequest": {
        "properties": {
          "actor": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Correction"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Changes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actor",
          "reason",
          "changes"
        ],
        "title": "CorrectionRequest"
      },
      "CorrectionSubmission": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "correction": {
            "$ref": "#/components/schemas/CorrectionRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "correction"
        ],
        "title": "CorrectionSubmission"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JsonValue": {},
      "StartRequest": {
        "properties": {
          "example_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Example Id"
          },
          "method": {
            "type": "string",
            "enum": [
              "ocr",
              "gemini"
            ],
            "title": "Method"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "example_id",
          "method"
        ],
        "title": "StartRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
